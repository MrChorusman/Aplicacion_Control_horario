# CONFIGURACIÓN DE TESTING
FLASK_ENV=testing
FLASK_DEBUG=False

# Base de datos en memoria para testing
DATABASE_URL=sqlite:///:memory:

# Redis para testing
REDIS_URL=redis://localhost:6380/0

# Frontend para testing
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# Configuración específica de testing
LOG_LEVEL=WARNING
LOG_FILE=logs/testing.log

# Configuración mínima para testing
SQLALCHEMY_POOL_SIZE=1
SQLALCHEMY_POOL_TIMEOUT=5

# Desactivar SSL para testing
SSL_CERT_PATH=
SSL_KEY_PATH=

# Desactivar rate limiting para testing
RATELIMIT_DEFAULT=10000 per hour

# Desactivar monitoreo en testing
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
DD_ENV=testing