# CONFIGURACIÓN DE STAGING
FLASK_ENV=staging
FLASK_DEBUG=False

# Base de datos Supabase staging
DATABASE_URL=postgresql://postgres:${SUPABASE_DB_PASSWORD}@db.staging-project.supabase.co:5432/postgres

# Redis staging
REDIS_URL=redis://staging-redis:6379/0

# Frontend staging
FRONTEND_URL=https://staging.control-horarios.com
ALLOWED_ORIGINS=https://staging.control-horarios.com

# Configuración de staging
LOG_LEVEL=INFO
LOG_FILE=logs/staging.log

# Performance optimizada para staging
SQLALCHEMY_POOL_SIZE=3
SQLALCHEMY_POOL_TIMEOUT=15
SQLALCHEMY_POOL_RECYCLE=3600

# Configuración SSL
SSL_CERT_PATH=/etc/ssl/staging/cert.pem
SSL_KEY_PATH=/etc/ssl/staging/key.pem

# Monitoreo en staging
SENTRY_DSN=${SENTRY_STAGING_DSN}
DD_ENV=staging