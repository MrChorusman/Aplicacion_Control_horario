# CONFIGURACIÓN DE PRODUCCIÓN
FLASK_ENV=production
FLASK_DEBUG=False

# Base de datos Supabase producción
DATABASE_URL=postgresql://postgres:${SUPABASE_DB_PASSWORD}@db.production-project.supabase.co:5432/postgres

# Redis producción (cluster)
REDIS_URL=redis://prod-redis-cluster:6379/0

# Frontend producción
FRONTEND_URL=https://control-horarios.com
ALLOWED_ORIGINS=https://control-horarios.com

# Configuración de producción
LOG_LEVEL=INFO
LOG_FILE=logs/production.log

# Performance optimizada para producción
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_MAX_OVERFLOW=20

# Configuración SSL obligatoria
SSL_CERT_PATH=/etc/ssl/production/cert.pem
SSL_KEY_PATH=/etc/ssl/production/key.pem

# Rate limiting estricto en producción
RATELIMIT_DEFAULT=500 per hour

# Monitoreo completo en producción
SENTRY_DSN=${SENTRY_PRODUCTION_DSN}
NEW_RELIC_LICENSE_KEY=${NEW_RELIC_PRODUCTION_KEY}
DD_ENV=production

# Backup en producción
BACKUP_S3_BUCKET=control-horarios-prod-backups
BACKUP_RETENTION_DAYS=90